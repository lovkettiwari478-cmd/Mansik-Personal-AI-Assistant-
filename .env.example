# MANISK environment configuration — copy to .env and fill in.
# NEVER commit the real .env file.

# ---- Core ----
MANISK_ENVIRONMENT=production            # production | development
MANISK_LOG_LEVEL=INFO
MANISK_SESSION_SECRET=change-me-to-a-long-random-string
MANISK_SESSION_TTL_HOURS=168
MANISK_COOKIE_SECURE=true                # false only for plain-HTTP dev

# SQLite by default; PostgreSQL for production scale:
# MANISK_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/mansik

# Where the built SPA lives (served same-origin by the API)
MANISK_FRONTEND_DIST=../frontend/dist

# ---- AI provider (any OpenAI-compatible API) ----
# NVIDIA NIM (Nemotron):
#   MANISK_AI_BASE_URL=https://integrate.api.nvidia.com/v1
#   MANISK_AI_MODEL=meta/llama-3.1-nemotron-70b-instruct
#   MANISK_AI_API_KEY=nvapi-...
# OpenAI:    https://api.openai.com/v1        model=gpt-4o-mini
# Groq:      https://api.groq.com/openai/v1   model=llama-3.3-70b-versatile
# Together:  https://api.together.xyz/v1
# Ollama:    http://127.0.0.1:11434/v1        (no API key needed)
MANISK_AI_BASE_URL=
MANISK_AI_API_KEY=
MANISK_AI_MODEL=
# Optional fallback provider (used when the primary fails)
MANISK_AI_FALLBACK_BASE_URL=
MANISK_AI_FALLBACK_API_KEY=
MANISK_AI_FALLBACK_MODEL=
MANISK_AI_TIMEOUT_SECONDS=120
MANISK_AI_MAX_TOKENS=1024

# ---- Tools ----
MANISK_TAVILY_API_KEY=                   # optional; keyless DuckDuckGo fallback is on
MANISK_ALLOW_DUCKDUCKGO_SEARCH=true
MANISK_HTTP_FETCH_ENABLED=true

# ---- Files ----
MANISK_STORAGE_DIR=./storage/files
MANISK_MAX_UPLOAD_BYTES=20971520

# ---- Email (optional, required for email.send tool) ----
MANISK_SMTP_HOST=
MANISK_SMTP_PORT=587
MANISK_SMTP_USER=
MANISK_SMTP_PASSWORD=
MANISK_SMTP_FROM=

# ---- Workers / limits ----
MANISK_SCHEDULER_ENABLED=true
MANISK_SCHEDULER_INTERVAL_SECONDS=30
MANISK_RATE_LIMIT_ENABLED=true
MANISK_RATE_LIMIT_AUTH_PER_MINUTE=10
MANISK_RATE_LIMIT_CHAT_PER_MINUTE=20
